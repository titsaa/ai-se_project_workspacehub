{
  "info": {
    "_postman_id": "dc2cb4bc-25db-4636-8aaf-97bc882c1011",
    "name": "WorkspaceHub Comment API Edge Cases",
    "description": "Unexpected-input checks for comment create, update, and read/delete routes. Permission denials are covered in the separate authorization collection. Requests run sequentially; the final request cleans up the valid test comment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001/api",
      "type": "string"
    },
    { "key": "ownerToken", "value": "", "type": "string" },
    { "key": "ownerId", "value": "", "type": "string" },
    { "key": "organizationId", "value": "", "type": "string" },
    { "key": "taskId", "value": "", "type": "string" },
    { "key": "commentId", "value": "", "type": "string" },
    {
      "key": "updatedContent",
      "value": "Valid content accepted after rejecting malformed bodies.",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Login as owner",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"owner@workspacehub.dev\",\n  \"password\": \"Password123!\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected: login succeeds and stores identity/token', function () {",
              "  pm.response.to.have.status(200);",
              "  const data = pm.response.json().data;",
              "  pm.collectionVariables.set('ownerToken', data.token);",
              "  pm.collectionVariables.set('ownerId', data.user._id);",
              "  pm.collectionVariables.set('organizationId', data.user.organizationId);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Get a task ID",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{ownerToken}}", "type": "string" }
          ]
        },
        "url": "{{baseUrl}}/tasks"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected: tasks load and first task ID is saved', function () {",
              "  pm.response.to.have.status(200);",
              "  const tasks = pm.response.json().data;",
              "  pm.expect(tasks.length).to.be.above(0);",
              "  pm.collectionVariables.set('taskId', tasks[0]._id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Create without content",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{ownerToken}}", "type": "string" }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/tasks/{{taskId}}/comments"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected: missing content is rejected with 400', function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
