        }
      ]
    },
    {
      "name": "09 Create valid comment with spoofed relationship fields",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{ownerToken}}", "type": "string" }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"Valid edge-case test comment.\",\n  \"authorId\": \"000000000000000000000001\",\n  \"organizationId\": \"000000000000000000000002\",\n  \"taskId\": \"000000000000000000000003\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/tasks/{{taskId}}/comments"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected: extra relationship fields are ignored; server uses authenticated owner and URL task', function () {",
              "  pm.response.to.have.status(201);",
              "  const comment = pm.response.json().data;",
              "  pm.expect(comment.authorId).to.eql(pm.collectionVariables.get('ownerId'));",
              "  pm.expect(comment.organizationId).to.eql(pm.collectionVariables.get('organizationId'));",
              "  pm.expect(comment.taskId).to.eql(pm.collectionVariables.get('taskId'));",
              "  pm.collectionVariables.set('commentId', comment._id);",
              "});"
            ]
          }
        }
      ]
    },
