    },
    {
      "name": "20 List comments after cleanup",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{ownerToken}}", "type": "string" }
          ]
        },
        "url": "{{baseUrl}}/tasks/{{taskId}}/comments"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected: seeded comments remain and temporary test comment is absent', function () {",
              "  pm.response.to.have.status(200);",
              "  const comments = pm.response.json().data;",
              "  pm.expect(comments.some(comment => comment._id === pm.collectionVariables.get('commentId'))).to.eql(false);",
              "  pm.expect(comments.some(comment => comment.content === 'This comment remains after the contributor is removed.')).to.eql(true);",
              "});"
            ]
          }
        }
