    {
      "name": "14 Update valid comment with spoofed fields",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{ownerToken}}", "type": "string" }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"{{updatedContent}}\",\n  \"authorId\": \"000000000000000000000001\",\n  \"organizationId\": \"000000000000000000000002\",\n  \"taskId\": \"000000000000000000000003\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/tasks/{{taskId}}/comments/{{commentId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected: content updates, relationship fields remain server-controlled', function () {",
              "  pm.response.to.have.status(200);",
              "  const comment = pm.response.json().data;",
              "  pm.expect(comment.content).to.eql(pm.collectionVariables.get('updatedContent'));",
              "  pm.expect(comment.authorId).to.eql(pm.collectionVariables.get('ownerId'));",
              "  pm.expect(comment.organizationId).to.eql(pm.collectionVariables.get('organizationId'));",
              "  pm.expect(comment.taskId).to.eql(pm.collectionVariables.get('taskId'));",
              "});"
            ]
          }
        }
      ]
    },
