{
  "info": {
    "_postman_id": "a1d15f21-bc01-4cc7-ae52-34db2bc1401d",
    "name": "WorkspaceHub Comment API Permissions",
    "description": "Sequential authorization tests for comment create, update, and delete. Each successful-delete scenario uses a fresh comment. The protected owner comment is intentionally left in the database for persistence verification.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001/api",
      "type": "string"
    },
    { "key": "taskId", "value": "", "type": "string" },
    { "key": "ownerToken", "value": "", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "memberToken", "value": "", "type": "string" },
    { "key": "memberEditCommentId", "value": "", "type": "string" },
    { "key": "memberDeleteCommentId", "value": "", "type": "string" },
    { "key": "ownerEditTargetId", "value": "", "type": "string" },
    { "key": "adminEditTargetId", "value": "", "type": "string" },
    { "key": "ownerDeleteTargetId", "value": "", "type": "string" },
    { "key": "adminDeleteTargetId", "value": "", "type": "string" },
