    {
      "name": "04 Get task ID",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{ownerToken}}", "type": "string" }
          ]
        },
        "url": "{{baseUrl}}/tasks"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "const tasks = pm.response.json().data;",
              "pm.expect(tasks.length).to.be.above(0);",
              "pm.collectionVariables.set('taskId', tasks[0]._id);"
            ]
          }
        }
      ]
    },
